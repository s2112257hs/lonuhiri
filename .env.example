# Keep real credentials in .env.local (gitignored), never in this example file.
MONGODB_URI=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google Business Profile: OAuth scope https://www.googleapis.com/auth/business.manage
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Exact ID strings, without accounts/ or locations/ prefixes.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Contact form: verify this sending subdomain in Resend, then add a sending API key.
RESEND_API_KEY=
CONTACT_ALIAS_DOMAIN=messages.lonuhiri.com
# A stable, random secret for repeatable aliases for each guest/booking pair.
CONTACT_ALIAS_SECRET=

# Optional temporary secret for POST /api/seed-admin initial setup/password recovery.
# Remove after setup/recovery. Never use a default/public token.
ADMIN_BOOTSTRAP_TOKEN=
